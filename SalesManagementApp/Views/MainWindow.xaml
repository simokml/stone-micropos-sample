<Window x:Class="SalesManagementApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام إدارة المبيعات" 
        Height="800" 
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- القائمة الجانبية -->
            <ColumnDefinition Width="250"/>
            <!-- المحتوى الرئيسي -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- القائمة الجانبية -->
        <Border Grid.Column="0" 
                Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            
            <Grid>
                <Grid.RowDefinitions>
                    <!-- شعار التطبيق -->
                    <RowDefinition Height="Auto"/>
                    <!-- القائمة -->
                    <RowDefinition Height="*"/>
                    <!-- معلومات المستخدم -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- شعار التطبيق -->
                <StackPanel Grid.Row="0" 
                           Orientation="Vertical" 
                           Margin="20"
                           HorizontalAlignment="Center">
                    
                    <TextBlock Text="💼" 
                              FontSize="48" 
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10"/>
                    
                    <TextBlock Text="نظام إدارة المبيعات"
                              Style="{StaticResource SubHeaderTextStyle}"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              TextWrapping="Wrap"/>
                    
                    <Rectangle Height="1" 
                              Fill="{StaticResource BorderBrush}"
                              Margin="0,15,0,0"/>
                </StackPanel>

                <!-- قائمة التنقل -->
                <ScrollViewer Grid.Row="1" 
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Hidden">
                    
                    <StackPanel Orientation="Vertical" Margin="0,10">
                        
                        <!-- الرئيسية -->
                        <Button x:Name="DashboardButton"
                               Content="🏠 الرئيسية"
                               Style="{StaticResource ActiveSideMenuButtonStyle}"
                               Click="DashboardButton_Click"/>

                        <!-- فاتورة المبيعات -->
                        <Button x:Name="InvoiceButton"
                               Content="🧾 فاتورة المبيعات"
                               Style="{StaticResource SideMenuButtonStyle}"
                               Click="InvoiceButton_Click"/>

                        <!-- العملاء -->
                        <Button x:Name="CustomersButton"
                               Content="👥 العملاء"
                               Style="{StaticResource SideMenuButtonStyle}"
                               Click="CustomersButton_Click"/>

                        <!-- الموردون -->
                        <Button x:Name="SuppliersButton"
                               Content="🏭 الموردون"
                               Style="{StaticResource SideMenuButtonStyle}"
                               Click="SuppliersButton_Click"/>

                        <!-- المخزون -->
                        <Button x:Name="InventoryButton"
                               Content="📦 المخزون"
                               Style="{StaticResource SideMenuButtonStyle}"
                               Click="InventoryButton_Click"/>

                        <!-- التقارير -->
                        <Button x:Name="ReportsButton"
                               Content="📊 التقارير"
                               Style="{StaticResource SideMenuButtonStyle}"
                               Click="ReportsButton_Click"/>

                        <Separator Margin="10,20" 
                                  Background="{StaticResource BorderBrush}"/>

                        <!-- الإعدادات -->
                        <Button x:Name="SettingsButton"
                               Content="⚙️ الإعدادات"
                               Style="{StaticResource SideMenuButtonStyle}"
                               Click="SettingsButton_Click"/>

                        <!-- النسخ الاحتياطي -->
                        <Button x:Name="BackupButton"
                               Content="💾 النسخ الاحتياطي"
                               Style="{StaticResource SideMenuButtonStyle}"
                               Click="BackupButton_Click"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- معلومات المستخدم -->
                <Border Grid.Row="2" 
                       Background="{StaticResource HoverBrush}"
                       Padding="15,10">
                    
                    <StackPanel Orientation="Vertical">
                        
                        <TextBlock Text="👤 المستخدم الحالي"
                                  FontSize="{StaticResource SmallFontSize}"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  HorizontalAlignment="Center"/>
                        
                        <TextBlock x:Name="CurrentUserText"
                                  Text="مدير النظام"
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,0"/>
                        
                        <TextBlock x:Name="CurrentDateText"
                                  FontSize="{StaticResource SmallFontSize}"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,0"/>
                        
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- المحتوى الرئيسي -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- شريط العنوان -->
                <RowDefinition Height="Auto"/>
                <!-- المحتوى -->
                <RowDefinition Height="*"/>
                <!-- شريط الحالة -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- شريط العنوان -->
            <Border Grid.Row="0" 
                   Background="{StaticResource SecondaryBackgroundBrush}"
                   BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,0,0,1"
                   Padding="20,15">
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- عنوان الصفحة -->
                    <TextBlock x:Name="PageTitleText"
                              Grid.Column="0"
                              Text="لوحة التحكم"
                              Style="{StaticResource HeaderTextStyle}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"/>

                    <!-- أزرار التحكم -->
                    <StackPanel Grid.Column="1" 
                               Orientation="Horizontal">
                        
                        <Button Content="🔄"
                               ToolTip="تحديث"
                               Style="{StaticResource SmallButtonStyle}"
                               Click="RefreshButton_Click"/>
                        
                        <Button Content="❓"
                               ToolTip="مساعدة"
                               Style="{StaticResource SmallButtonStyle}"
                               Click="HelpButton_Click"/>
                        
                    </StackPanel>
                </Grid>
            </Border>

            <!-- منطقة المحتوى -->
            <ContentControl x:Name="MainContentArea"
                           Grid.Row="1"
                           Margin="20"/>

            <!-- شريط الحالة -->
            <Border Grid.Row="2" 
                   Background="{StaticResource SecondaryBackgroundBrush}"
                   BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,1,0,0"
                   Padding="20,8">
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- رسالة الحالة -->
                    <TextBlock x:Name="StatusMessageText"
                              Grid.Column="0"
                              Text="جاهز"
                              FontSize="{StaticResource SmallFontSize}"
                              VerticalAlignment="Center"/>

                    <!-- معلومات إضافية -->
                    <StackPanel Grid.Column="1" 
                               Orientation="Horizontal">
                        
                        <TextBlock x:Name="ConnectionStatusText"
                                  Text="🟢 متصل"
                                  FontSize="{StaticResource SmallFontSize}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,15,0"/>
                        
                        <TextBlock x:Name="VersionText"
                                  Text="الإصدار 1.0"
                                  FontSize="{StaticResource SmallFontSize}"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  VerticalAlignment="Center"/>
                        
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Window>
